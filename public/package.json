  "scripts": {
    "build": "sass --style=expanded --source-map sass/index.scss:.build/css/index.css && postcss .build/css/index.css --use autoprefixer --replace --map",
    "watch": "sass --watch --style=expanded --source-map sass/index.scss:.build/css/index.css",
    "test": "node --test ../tests/*.test.cjs",
    "audit": "node ../scripts/audit.cjs ."
  },
